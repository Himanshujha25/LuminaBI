{
  "version": 2,
  "name": "dashtalk",
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": { "distDir": "dist" }
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://dashtalk.onrender.com/api/$1"
    },
    {
      "source": "/query/(.*)",
      "destination": "https://dashtalk.onrender.com/query/$1"
    },
    {
      "source": "/health",
      "destination": "https://dashtalk.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
